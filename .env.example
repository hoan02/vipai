# Where the API gateway lives.
#
# The Encore Go backend was retired. Auth, API keys, quota and billing all live
# in the new-api gateway, which Caddy serves under the prefix below on this same
# origin, so there is one hostname, one tunnel and no cross-origin CORS.
#
# NEXT_PUBLIC_API_URL and NEXT_PUBLIC_API_URL_PATH are inlined into the client
# bundle at build time, so changing them requires a rebuild, not just a restart.
# BACKEND_API_URL is read on the server and can change without one.

# Browser-visible origin.
NEXT_PUBLIC_API_URL="https://aigiare.site"

# Prefix that Caddy strips before proxying to the gateway, so /_aigiare/v1/...
# reaches the gateway as /v1/...
NEXT_PUBLIC_API_URL_PATH="/_aigiare"

# Server-side only. On the VM this points at Caddy on the compose network rather
# than the public origin, so a server-side render never leaves the host.
BACKEND_API_URL="http://caddy:80/_aigiare"
