# ---------------------------------------------------------------------------
# AiGiare — environment variables
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Postgres connection string (Neon / Supabase / Vercel Postgres).
# The app runs without it, but the real backend (API keys, usage, token
# requests) only persists data once this is set.
DATABASE_URL="postgresql://user:password@host:5432/aigiare?sslmode=require"

# Clerk — run `npx clerk@latest init` to auto-provision a dev app and write
# these for you, or paste them from https://dashboard.clerk.com.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"
